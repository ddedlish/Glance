<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent logic shared by the Windows and Linux apps. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Glance</RootNamespace>
    <AssemblyName>Glance.Core</AssemblyName>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glance" />
    <InternalsVisibleTo Include="Glance.Tests" />
    <InternalsVisibleTo Include="Glance.Android" />
    <Using Include="System.Drawing" />
  </ItemGroup>

</Project>
