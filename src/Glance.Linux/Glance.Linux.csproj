<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Glance</AssemblyName>
    <RootNamespace>Glance</RootNamespace>
    <Version>2.4.7</Version>
    <Product>Glance</Product>
    <Authors>ddedlish</Authors>
    <AssemblyTitle>Glance — заряд аксессуаров · by ddedlish</AssemblyTitle>
    <Copyright>© 2026 ddedlish · steamcommunity.com/id/ddedlish</Copyright>
    <Company>ddedlish</Company>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <!-- No libicu needed on the target system -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Update source, injected by CI: -p:GlanceUpdateRepo=owner/repo -->
  <ItemGroup Condition="'$(GlanceUpdateRepo)' != ''">
    <AssemblyMetadata Include="GlanceUpdateRepo" Value="$(GlanceUpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus" Version="0.*" />
    <ProjectReference Include="..\Glance.Core\Glance.Core.csproj" />
    <EmbeddedResource Include="glance.png" LogicalName="glance.png" />
  </ItemGroup>

</Project>
