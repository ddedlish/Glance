<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection gives direct access to WinRT Bluetooth / Gaming APIs without extra packages -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Glance</AssemblyName>
    <RootNamespace>Glance</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>4.2.12</Version>
    <Product>Glance</Product>
    <Authors>ddedlish</Authors>
    <AssemblyTitle>Glance — заряд аксессуаров · by ddedlish</AssemblyTitle>
    <Copyright>© 2026 ddedlish · steamcommunity.com/id/ddedlish</Copyright>
    <Company>ddedlish</Company>
    <Description>Заряд Bluetooth-аксессуаров в трее Windows</Description>
    

    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- Low footprint -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- Publishing with -r win-x64 / win-x86: one self-contained file, no .NET install needed on the user's PC -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Uncompressed bundle: the compressor's output differs between build machines (CPU-specific zlib), which made
         every other delta update ~50 MB. Uncompressed, unchanged runtime files are byte-identical → updates stay
         a few hundred KB; the runtime is also memory-mapped instead of unpacked (faster start, less RAM).
         No ReadyToRun: it recompiles the runtime per build and breaks deltas the same way. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!-- Update source, injected by CI: -p:GlanceUpdateRepo=owner/repo -->
  <ItemGroup Condition="'$(GlanceUpdateRepo)' != ''">
    <AssemblyMetadata Include="GlanceUpdateRepo" Value="$(GlanceUpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <!-- DirectWrite/Direct2D text on glass (grayscale, gamma-correct, premultiplied alpha — like WinUI/iOS) -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GlanceChannel" Value="Alpha" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glance.Core\Glance.Core.csproj" />
  </ItemGroup>

</Project>
